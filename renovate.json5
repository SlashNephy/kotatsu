{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>SlashNephy/renovate-config',
  ],
  // main が進んでも、コンフリクトしない限り PR を作り直さない。自動マージする PR は、既定では main より遅れるたびに
  // 作り直され、そのたびに CI、Image、CodeQL が動いて、開いている PR の数だけランナーを待たせるため。
  // 必須のチェック (ルールセット) は main への追従を求めないので、作り直さなくても自動マージできる。
  rebaseWhen: 'conflicted',
  packageRules: [
    {
      // wasm-bindgen の CLI は、mpeg2toh264 の Cargo.lock の wasm-bindgen と同じ版でないと使えない。
      // mpeg2toh264 の commit を上げるときに、合わせて手で上げる。
      matchFileNames: [
        'mise.mpeg2toh264.toml',
      ],
      matchDepNames: [
        '/wasm-bindgen/',
      ],
      enabled: false,
    },
    {
      // CI で確かめる、対応する最も古い DB の版 (.github/workflows/ci.yml の oldest) と、atlas.hcl の開発用 DB。
      // 古いバージョンのマネージド DB や EPGStation の利用者の DB で動くことを確かめるために残すので、メジャーバージョンは手で上げる。
      matchDepTypes: [
        'oldest',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      // atlas.hcl の開発用 DB の URL (docker+postgres://) には、digest を書けない。
      matchFileNames: [
        'backend/atlas.hcl',
      ],
      pinDigests: false,
    },
    {
      // 配布物の例 (deploy/) にある Kotatsu 自身のイメージは、利用者が edge の最新を追うためのものなので、digest で固定しない。
      matchDepNames: [
        'ghcr.io/slashnephy/kotatsu',
      ],
      enabled: false,
    },
  ],
  customManagers: [
    {
      // 字幕を描くフォント。リリースのタグと、添付のフォントの sha256 を合わせて上げる。
      customType: 'regex',
      managerFilePatterns: [
        '/^frontend/vendor/caption-font/SOURCE$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\ntag=(?<currentValue>\\S+)\\nsha256=(?<currentDigest>[0-9a-f]{64})',
      ],
      versioningTemplate: 'loose',
      autoReplaceStringTemplate: '# renovate: datasource={{{datasource}}} depName={{{depName}}}\ntag={{{newValue}}}\nsha256={{{newDigest}}}',
    },
    {
      // ブラウザ内での変換に使う mpeg2toh264 の commit (設計書 7.2)。更新したら、mise run web:mpeg2toh264 でビルドし直す。
      customType: 'regex',
      managerFilePatterns: [
        '/^frontend/vendor/mpeg2toh264/SOURCE$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\ncommit=(?<currentDigest>[0-9a-f]{40})',
      ],
      autoReplaceStringTemplate: '# renovate: datasource={{{datasource}}} depName={{{depName}}} currentValue={{{currentValue}}}\ncommit={{{newDigest}}}',
    },
    {
      // atlas.hcl の開発用 DB のイメージ。
      customType: 'regex',
      managerFilePatterns: [
        '/^backend/atlas\\.hcl$/',
      ],
      matchStrings: [
        'docker\\+postgres://(?<depName>[^:]+):(?<currentValue>[^/]+)/',
      ],
      datasourceTemplate: 'docker',
      depTypeTemplate: 'oldest',
    },
    {
      // CI で確かめる DB の版。oldest と latest の 2 つの版を、matrix の値として書いている。
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/ci\\.yml$/',
      ],
      matchStrings: [
        '(?<depName>docker\\.io/library/[a-z]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))? # renovate: (?<depType>oldest|latest)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
