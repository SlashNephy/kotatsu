{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>SlashNephy/renovate-config',
  ],
  // main が進んでも、コンフリクトしない限り PR を作り直さない。自動マージする PR は、既定では main より遅れるたびに
  // 作り直され、そのたびに CI、Image、CodeQL が動いて、開いている PR の数だけランナーを待たせるため。
  // 必須のチェック (ルールセット) は main への追従を求めないので、作り直さなくても自動マージできる。
  rebaseWhen: 'conflicted',
  packageRules: [
    {
      // actions は、uses: にタグで書き、commit は .github/workflows/actions.lock で固定する (#790)。
      // 共有の設定 (helpers:pinGitHubActionDigestsToSemver) は uses: を digest に固定し直すので、ここでは固定しない。
      // actions を上げる PR では、Renovate がロックファイルも作り直す。
      matchManagers: [
        'github-actions',
      ],
      pinDigests: false,
    },
    {
      // wasm-bindgen の CLI は、mpeg2toh264 の Cargo.lock の wasm-bindgen と同じバージョンでないと使えない。
      // mpeg2toh264 の commit を上げるときに、合わせて手で上げる。
      matchFileNames: [
        'frontend/mise.mpeg2toh264.toml',
      ],
      matchDepNames: [
        '/wasm-bindgen/',
      ],
      enabled: false,
    },
    {
      // CI で確認する、対応する最も古い DB のバージョン (.github/workflows/ci.yml の oldest) と、atlas.hcl の開発用 DB。
      // 古いバージョンのマネージド DB や EPGStation の利用者の DB で動くことを確認するために残すので、メジャーバージョンは手で上げる。
      matchDepTypes: [
        'oldest',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      // nv-codec-headers のバージョンで、NVENC と NVDEC が動く NVIDIA のドライバの下限が決まる (Dockerfile の NV_CODEC_HEADERS_VERSION)。
      // 下限を上げると、古いドライバの利用者の NVENC が動かなくなるので、12.1 の中でだけ上げ、それより上は手で上げる。
      matchDepNames: [
        'FFmpeg/nv-codec-headers',
      ],
      allowedVersions: '/^12\\.1\\./',
    },
    {
      // atlas.hcl の開発用 DB の URL (docker+postgres://) には、digest を書けない。
      matchFileNames: [
        'backend/atlas.hcl',
      ],
      pinDigests: false,
    },
    {
      // 配布物の例 (deploy/) にある Kotatsu 自身のイメージは、利用者が edge の最新を追うためのものなので、digest で固定しない。
      matchDepNames: [
        'ghcr.io/slashnephy/kotatsu',
      ],
      enabled: false,
    },
    {
      // get-nonce は、Mantine の Modal と Drawer が使う react-remove-scroll の依存で、CSP の nonce を渡すために直に呼ぶ。
      // 12 行で完結したモジュールなので、更新が止まっていても困らない。Mantine が依存を外したら、直の依存もやめる (#1471)。
      matchPackageNames: [
        'get-nonce',
      ],
      abandonmentThreshold: null,
    },
    {
      // go-ruleguard の dsl は、golangci-lint のルール (backend/lint/) を書くためだけに使い、配布物には入らない。
      // ルールが動いている限り、更新が止まっていても困らない (#1471)。
      matchPackageNames: [
        'github.com/quasilyte/go-ruleguard/dsl',
      ],
      abandonmentThreshold: null,
    },
    {
      // mise の conda バックエンドは、channel を書かなければ conda-forge から入れる (frontend/mise.demo-stream.toml)。
      // Renovate は channel のないまま Anaconda.org を引いて見つけられないので、conda-forge の名前で引かせる。
      matchDatasources: [
        'conda',
      ],
      matchPackageNames: [
        'ffmpeg',
      ],
      overridePackageName: 'conda-forge/ffmpeg',
    },
  ],
  customManagers: [
    {
      // 字幕を描くフォント。リリースのタグと、添付のフォントの sha256 を合わせて上げる。
      customType: 'regex',
      managerFilePatterns: [
        '/^frontend/vendor/caption-font/SOURCE$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\ntag=(?<currentValue>\\S+)\\nsha256=(?<currentDigest>[0-9a-f]{64})',
      ],
      versioningTemplate: 'loose',
      autoReplaceStringTemplate: '# renovate: datasource={{{datasource}}} depName={{{depName}}}\ntag={{{newValue}}}\nsha256={{{newDigest}}}',
    },
    {
      // ブラウザ内での変換に使う mpeg2toh264 の commit (設計書 7.2)。更新したら、mise run //frontend:mpeg2toh264 でビルドし直す。
      customType: 'regex',
      managerFilePatterns: [
        '/^frontend/vendor/mpeg2toh264/SOURCE$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\ncommit=(?<currentDigest>[0-9a-f]{40})',
      ],
      autoReplaceStringTemplate: '# renovate: datasource={{{datasource}}} depName={{{depName}}} currentValue={{{currentValue}}}\ncommit={{{newDigest}}}',
    },
    {
      // 字幕の外字の既定のテーブルを作る libaribcaption の commit (設計書 7.4)。
      customType: 'regex',
      managerFilePatterns: [
        '/^frontend/vendor/libaribcaption/SOURCE$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\ncommit=(?<currentDigest>[0-9a-f]{40})',
      ],
      autoReplaceStringTemplate: '# renovate: datasource={{{datasource}}} depName={{{depName}}} currentValue={{{currentValue}}}\ncommit={{{newDigest}}}',
    },
    {
      // ブラウザ内でデコードする経路の WASM の FFmpeg のバージョンと emscripten のイメージ (#1516)。
      // FFmpeg は、サーバの FFmpeg (Dockerfile の FFMPEG_VERSION) と同じバージョンを追う。
      // 上げたら、mise run //frontend:ffmpeg で組み直したものを、同じ PR に入れる (CI が差分を確認する)。
      customType: 'regex',
      managerFilePatterns: [
        '/^frontend/vendor/ffmpeg/SOURCE$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+) extractVersion=(?<extractVersion>\\S+)\\nffmpeg=(?<currentValue>\\S+)',
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nemsdk=(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
      ],
    },
    {
      // atlas.hcl の開発用 DB のイメージ。
      customType: 'regex',
      managerFilePatterns: [
        '/^backend/atlas\\.hcl$/',
      ],
      matchStrings: [
        'docker\\+postgres://(?<depName>[^:]+):(?<currentValue>[^/]+)/',
      ],
      datasourceTemplate: 'docker',
      depTypeTemplate: 'oldest',
    },
    {
      // CI の words のジョブが使う yomiyasu の lint。タグとコミットを合わせて上げる (#2131)。
      customType: 'regex',
      managerFilePatterns: [
        '/^scripts/yomiyasu\\.SOURCE$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\ncommit=(?<currentDigest>[0-9a-f]{40})',
      ],
      autoReplaceStringTemplate: '# renovate: datasource={{{datasource}}} depName={{{depName}}} currentValue={{{newValue}}}\ncommit={{{newDigest}}}',
    },
    {
      // CI で確認する DB のバージョン。oldest と latest の 2 つのバージョンを、matrix の値として書いている。
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/ci\\.yml$/',
      ],
      matchStrings: [
        '(?<depName>docker\\.io/library/[a-z]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))? # renovate: (?<depType>oldest|latest)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
