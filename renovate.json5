{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>SlashNephy/renovate-config',
  ],
  customManagers: [
    {
      // atlas.hcl の開発用 DB のイメージ。
      customType: 'regex',
      managerFilePatterns: [
        '/^atlas\\.hcl$/',
      ],
      matchStrings: [
        'docker\\+postgres://(?<depName>[^:]+):(?<currentValue>[^/]+)/',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
