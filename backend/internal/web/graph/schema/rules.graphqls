"""
キーワードと、その照合の仕方。
"""
type Keyword {
  text: String!
  regexp: Boolean!
  caseSensitive: Boolean!
  fields: [KeywordField!]!
}

"""
曜日と時間帯の組。
"""
type TimeRange {
  "曜日の集合 (0 が日曜日、6 が土曜日)"
  weekdays: [Int!]!
  "0 時からの分で表した範囲の始まり"
  startMinute: Int!
  "範囲の長さ (分)"
  durationMinutes: Int!
}

"""
番組の条件 (設計書 4.2)。空の項目では絞り込まない。
"""
type ProgramConditions {
  keywords: [Keyword!]!
  keywordMatch: KeywordMatch!
  excludeKeywords: [Keyword!]!
  channelTypes: [String!]!
  services: [Service!]!
  "チャンネル種別やサービスで対象になっても、含まれていれば除外するサービス"
  excludeServices: [Service!]!
  genres: [GenreCondition!]!
  excludeGenres: [GenreCondition!]!
  timeRanges: [TimeRange!]!
  minDurationSeconds: Int
  maxDurationSeconds: Int
  freeOnly: Boolean!
  "番組名の囲み文字 (中身で表す。「新」や「字」など。括弧で書いた [新] なども同じとみなす)。どれか 1 つを持つ番組を対象にする。"
  marks: [String!]!
  "どれか 1 つを持つ番組を除外する囲み文字"
  excludeMarks: [String!]!
}

"""
録画設定の上書き (設計書 4.7)。null の項目は全体の既定値を使う。
"""
type RecordingSettingsOverrides {
  "保存先プール"
  poolId: String
  "ファイル名の text/template"
  fileNameTemplate: String
  startMarginSeconds: Int
  endMarginSeconds: Int
  "優先度 (-10〜10)。チューナーが足りないときは、高い予約から割り当てる。"
  priority: Int
  "分かれた録画のファイルを、録画が終わったら 1 つにつなぐかどうか"
  joinSegments: Boolean
}

"""
録画設定の上書き。省いた項目は全体の既定値を使う。
"""
input RecordingSettingsOverridesInput {
  poolId: String
  fileNameTemplate: String
  startMarginSeconds: Int
  endMarginSeconds: Int
  priority: Int
  joinSegments: Boolean
}

"""
ルール (設計書 4.2)。ルールは家族で共有し、メンバーなら誰が作ったものでも変えられる (設計書 9.7)。
"""
type Rule implements Node {
  id: ID!
  name: String!
  memo: String!
  enabled: Boolean!
  conditions: ProgramConditions!
  settings: RecordingSettingsOverrides!
  "ルール自体の有効期間。番組の開始時刻がこの範囲に入るときだけ予約する。null なら区切らない。"
  validFrom: Time
  validUntil: Time
  "同じ番組名を duplicateWindowDays 日以内に録画済みなら予約しないかどうか (設計書 4.4)。"
  avoidDuplicates: Boolean!
  "重複を避ける期間 (日)。null なら期間を区切らない。"
  duplicateWindowDays: Int
  "イベントリレーで引き継がれた番組を、引き継ぎ先でも予約するかどうか (設計書 4.6)。"
  followEventRelay: Boolean!
  createdAt: Time!
  "作成者。ユーザーが消えていれば null。"
  createdBy: User
  updatedAt: Time!
  updatedBy: User
  "このルールに一致した予約のうち、終わっていないものの件数。無効にした予約も数える。"
  upcomingReservationCount: Int!
}

"""
ルールの内容。
"""
input RuleInput {
  "1〜200 文字"
  name: String!
  "2000 文字まで"
  memo: String! = ""
  enabled: Boolean! = true
  conditions: ProgramConditionsInput!
  settings: RecordingSettingsOverridesInput
  validFrom: Time
  validUntil: Time
  avoidDuplicates: Boolean! = false
  "1〜3650"
  duplicateWindowDays: Int
  followEventRelay: Boolean! = true
}

"ルールの照合を重くする書き方 (#904、設計書 3.5)。警告にとどめ、保存は止めない。"
type RuleWarning {
  kind: RuleWarningKind!
  "除外するキーワード (excludeKeywords) かどうか"
  exclude: Boolean!
  "keywords か excludeKeywords の中の位置 (0 から)"
  index: Int!
}

enum RuleWarningKind {
  "必ず含む文字列を決められない正規表現で、詳細まで探す。前段で絞り込めないので、すべての番組の詳細を正規表現にかける。"
  UNFILTERABLE_REGEXP
}

extend type Query {
  "すべてのルールを、作った順に返す。"
  rules: [Rule!]!
  "保存する前のルールの、照合を重くする書き方を返す (#904)。ルールのプレビューと同じく、誰でも使える。"
  ruleWarnings(input: RuleInput!): [RuleWarning!]!
  """
  保存する前のルールに一致する番組を、開始時刻の順に返す (設計書 4.3)。
  ルールの照合と同じく、放送が始まった番組、終了時刻が未定の番組、ルールの有効期間の外の番組は含めない。
  重複の回避は考えない。first、after と hasNextPage、イベント共有の扱いは searchPrograms と同じ。
  """
  previewRule(
    input: RuleInput!
    "返す件数 (1〜100)"
    first: Int! = 50
    after: String
  ): ProgramConnection!
}

extend type Mutation {
  "ルールを作る。視聴者は使えない。"
  createRule(input: RuleInput!): Rule!
  "ルールの内容を input で置き換える。視聴者は使えない。"
  updateRule(id: ID!, input: RuleInput!): Rule!
  "ルールを有効または無効にする。視聴者は使えない。"
  setRuleEnabled(id: ID!, enabled: Boolean!): Rule!
  "ルールを消し、消したルールの ID を返す。このルールだけに一致していた予約は、次の照合で消える。視聴者は使えない。"
  deleteRule(id: ID!): ID!
  """
  ルール ids をまとめて有効か無効にする (#471)。視聴者は使えない。監査ログは 1 件ずつ残す。
  見つからないルールは飛ばした数に数える。一度に 500 件まで。
  """
  setRulesEnabled(ids: [ID!]!, enabled: Boolean!): BulkOperationPayload!
  """
  ルール ids をまとめて消す (#471)。視聴者は使えない。監査ログは 1 件ずつ残す。
  そのルールだけに一致していた予約は、次の照合で消える。ただし、録画中の予約は消さず、最後まで録る。
  見つからないルールは飛ばした数に数える。一度に 500 件まで。
  """
  deleteRules(ids: [ID!]!): BulkOperationPayload!
}
