"""
外部プレイヤー (VLC や mpv) で開くための、署名付きの映像の URL (設計書 7.6、9.6)。
URL には、リソース、URL を発行したユーザー、有効期限に対する署名が付く。中身は TS をそのまま流す。
"""
type StreamURL {
  """
  パスとクエリ (例: /api/streams/services/3273601024?expires=...&sig=...&user=...)。オリジンは含まないので、ページのオリジンを補って使う。
  録画の URL には、署名を変えずに start (録画の始まりからの秒) を足して、再生を始める位置を指定できる。
  """
  url: String!
  "有効期限。録画なら録画の長さに 1 時間を足した長さ、ライブなら発行から 1 時間 (#1756)。"
  expiresAt: Time!
}

extend type Mutation {
  """
  サービス (ライブ視聴) か録画 (再生) の、署名付きの映像の URL を発行する。誰でも使える。
  管理者が外部プレイヤー用の URL を有効にしていなければ (SystemSettings.externalPlayerUrlsEnabled)、FORBIDDEN を返す (#1755)。
  target には、Service か Recording の ID を渡す。
  """
  createStreamURL(target: ID!): StreamURL!
}

"""
サーバー側でのトランスコード (kyusu) の映像のコーデック。
"""
enum VideoCodec {
  H264
  HEVC
}

"""
放送の映像の種類 (設計書 7.1)。再生の経路を選ぶのに使う (#806)。
"""
enum VideoFormat {
  "2K 以下の映像 (地上波、BS、CS)。ブラウザ内での変換で再生できる。"
  HD
  "BS4K の 2160p の HEVC。ブラウザ内での変換では再生できない。"
  UHD
  "BS8K の 4320p の HEVC。ブラウザでは再生できない。"
  SHV
}

"""
サーバー側でのトランスコードの画質 (設計書 7.3)。
"""
type StreamPreset {
  """
  URL に使う名前 (720p、720p-hevc など)。HLS は /internal/streams/{services|recordings}/{id}/hls/{name}/{audio}/playlist.m3u8 で取る。
  audio は、第 1 音声なら 1、第 2 音声 (デュアルモノの副音声や 2 つ目の音声) なら 2。
  """
  name: String!
  height: Int!
  "映像のビットレート (kbps)。"
  videoBitrate: Int!
  codec: VideoCodec!
  """
  映像を変換せずに、放送の HEVC のまま送るかどうか (#806)。BS4K の番組を、HEVC を復号できる端末で見るのに使う。
  height と videoBitrate は、BS4K の放送の目安。
  """
  passthrough: Boolean!
}

"""
サーバー側でのトランスコード (kyusu) の状態 (設計書 7.1)。
"""
type Transcoding {
  "トランスコードできる kyusu が動いているかどうか。動いていなければ、ブラウザ内での変換だけを使える。"
  available: Boolean!
  "選べる画質。H.264、HEVC の順に、それぞれ高い画質から並べ、最後に映像を変換しないものを置く。"
  presets: [StreamPreset!]!
}

extend type Query {
  "サーバー側でのトランスコードを使えるかと、選べる画質。"
  transcoding: Transcoding!
}

"""
ライブのサービスの、PID の種類ごとのビットレートと、TS のパケットの異常の数 (#812)。
"""
type LiveStreamRates {
  "映像のビットレート (bps)。"
  videoBps: Int!
  "音声のビットレート (bps)。"
  audioBps: Int!
  "字幕、文字スーパー、データ放送など、映像と音声のほかの ES のビットレート (bps)。"
  otherBps: Int!
  "PAT、PMT と、決まった PID で送る SI のビットレート (bps)。"
  psiBps: Int!
  "PMT に載っていない PID (ECM、EMM など) のビットレート (bps)。"
  unknownBps: Int!
  "全体のビットレート (bps)。"
  totalBps: Int!
  "数え始めてからの、ドロップ、エラー、スクランブルの数。"
  drops: Int64!
  errors: Int64!
  scrambled: Int64!
  "放送の時計 (#1515)。まだ PCR を読めていなければ null。"
  broadcastClock: BroadcastClock
  "内訳を送る時点のサーバーの時計。画面は、端末の時計との差を、これで測る (#1515)。"
  serverTime: Time!
}

"""
放送の時計 (#1515)。PCR と、それを含む TS を tenban が受け取った時刻の組。受け取った時刻から PCR を引いた量が最も小さい組を送る。
映しているコマの放送の時刻は、receivedAt + (コマの PTS − pcr) で出せる。
"""
type BroadcastClock {
  "PCR の基準部 (90 kHz) を秒にしたもの。"
  pcr: Float!
  "PCR を含む TS を tenban が受け取った時刻。"
  receivedAt: Time!
}

extend type Subscription {
  """
  ライブのサービス service の、PID の種類ごとのビットレートを、1 秒ごとに送る (#812、設計書 7.5)。
  tenban が、チューナーを奪わない優先度でサービスのストリームを別に開いて数える。見ている人がいれば、同じチューナーに相乗りする。
  ブラウザに届く TS ではなく、放送の内訳を送るので、kyusu の経路で見ていても使える。購読をやめると、ストリームを閉じる。
  """
  liveStreamRates(service: ID!): LiveStreamRates!
}

"""
ライブのサービスが、スクランブルされたまま届くと決めたこと (設計書 7.1、#1517)。viewerEvents で届く。
"""
type LiveStreamScrambled {
  "決めたサービス。"
  service: ID!
  "決めた日時。"
  decidedAt: Time!
}
