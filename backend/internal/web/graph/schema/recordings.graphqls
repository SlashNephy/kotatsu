"""
録画の状態 (設計書 5.5)。
"""
enum RecordingState {
  "録画中"
  RECORDING
  "完了"
  COMPLETED
  "ドロップのある完了"
  COMPLETED_WITH_ERRORS
  "途切れた区間のある一部のみ"
  PARTIAL
  "失敗"
  FAILED
}

"""
録画に失敗した理由 (設計書 5.5)。
"""
enum RecordingFailureReason {
  "チューナーを確保できなかった"
  TUNER_UNAVAILABLE
  "チューナーサーバーに接続できなかった"
  TUNER_SERVER_UNREACHABLE
  "ストリームが中断し、再接続もできなかった"
  STREAM_INTERRUPTED
  "保存先に書き込めなかった"
  STORAGE_UNAVAILABLE
  "保存先の容量が足りなかった"
  STORAGE_FULL
  "番組が見つからなかった"
  PROGRAM_NOT_FOUND
  "録画を取り消した"
  CANCELLED
  "録画を始める時刻に、録画できる mikan がいなかった"
  RECORDER_UNAVAILABLE
}

"""
録画のファイルの種類。
"""
enum RecordingFileKind {
  "TS のセグメント"
  SEGMENT
  "EPGStation から取り込んだ、エンコード済みの MP4 のような TS 以外のファイル"
  OTHER
}

"""
録画のファイル。
"""
type RecordingFile {
  kind: RecordingFileKind!
  "保存先プールの ID。"
  poolId: String!
  "プール内の相対パス。"
  path: String!
  "大きさ (バイト)。書いている間は、このインスタンスから読めれば、ファイルの今の大きさ。"
  size: Int64!
  startedAt: Time!
  "書き終えた日時。書いている間は null。"
  endedAt: Time
  """
  ファイルをそのまま流す URL のパス。その他のファイル (OTHER) だけにあり、ほかの種類では null。
  ブラウザがそのコーデックに対応していれば、<video> でそのまま再生できる (設計書 6.3)。
  """
  url: String
  "セグメントの映像から読んだ映像の形式 (#1310)。読めなかったセグメントと、その他のファイルでは null。"
  video: SegmentVideoFormat
  """
  セグメントを書いたストリームを受信していたチューナー (#1467)。見つけられなかったセグメントと、その他のファイルでは null。
  名前は上流のチューナーのホスト名を含むことがあるので、管理者にだけ返す。ほかのユーザーには null を返す。
  """
  tuner: RecordingFileTuner
  """
  Kotatsu が録画を変換した MP4 の、1 秒あたりのコマ数 (#1509)。30 か 60 (プログレッシブの映像は元のコマ数)。
  セグメントと、取り込んだファイルと、コマ数を記録する前に変換した MP4 では null。
  """
  transcodeFrameRate: Int
}

"""
セグメントを書いたストリームを受信していたチューナー (#1467)。録画したときの写しで、今のチューナーの構成とは違うことがある。
"""
type RecordingFileTuner {
  "チューナーサーバーでのチューナーの番号。リモートのチューナーは負の数になることがある。"
  index: Int!
  name: String!
}

"""
セグメントの映像のシーケンスヘッダーか SPS から読んだ映像の形式 (#1310)。
"""
type SegmentVideoFormat {
  "mpeg2、h264、hevc のどれか。"
  codec: String!
  width: Int!
  height: Int!
  interlaced: Boolean!
  "フレームレート。読めなければ null (HEVC は読まない)。"
  frameRate: Float
}

"""
途切れた区間。
"""
type RecordingGap {
  from: Time!
  to: Time!
}

"""
CM とみなした区間 (#479)。録画を終えた後に、nekonote が見分ける。
"""
type RecordingCMSection {
  "区間の始まりと終わり。録画の時間軸の日時で、途切れた区間 (gaps) と同じく、再生の位置にするには途切れた分を詰める。"
  from: Time!
  to: Time!
}

"""
録画のタグ。
"""
type Tag {
  id: ID!
  name: String!
  "このタグが付いた録画の数。"
  recordings: Int!
}

"""
録画 (設計書 5.5、8.2)。
"""
type Recording implements Node {
  id: ID!
  service: Service!
  "番組の eventId。時刻予約の録画では null。"
  eventId: Int
  name: String!
  description: String!
  "番組の放送の開始と終了。"
  startAt: Time!
  endAt: Time!
  state: RecordingState!
  "失敗した理由。失敗していなければ null。"
  failureReason: RecordingFailureReason
  """
  失敗した理由に至った、最後のエラーの本文 (#1467)。失敗していないか、本文がなければ null。
  上流のチューナーのホスト名などを含むので、管理者にだけ返す。ほかのユーザーには null を返す。
  """
  failureDetail: String
  "保護の印。保護した録画は、容量の管理でも、ユーザーの操作でも消さない。"
  protected: Boolean!
  "全 PID のドロップ、エラー、スクランブルの数。"
  drops: Int64!
  errors: Int64!
  scrambled: Int64!
  """
  スクランブルされたまま録れたという警告の印 (設計書 5.5、#1517)。録画全体か、どれかのセグメントで、
  ES のパケットのうちスクランブルされていたものの割合が閾値を超えたら立つ。状態とは別の印で、失敗にはしない。
  """
  scrambleWarning: Boolean!
  "ES の PID だけで出した、スクランブルされていたパケットの割合 (0〜1、#1517)。ES のパケットが少なくて判定しなかった録画では null。"
  scrambledRatio: Float
  """
  PID ごとの、パケット、ドロップ、エラー、スクランブルの数 (#473)。セグメントを足し合わせ、PID の昇順に並べる。
  集計を記録する前に閉じたセグメントは含めない。引き継ぎで重なった区間は、drops などと違って二重に数える。
  """
  streamQuality: [StreamQuality!]!
  gaps: [RecordingGap!]!
  "CM とみなした区間を、始まりの順に並べる (#479)。見分けていないか、見つからなければ空になる。"
  cmSections: [RecordingCMSection!]!
  "録画を始めたときの番組の音声の構成。主音声を先に並べる。時刻予約の録画や、構成を知らない録画では空になる。"
  audios: [ProgramAudio!]!
  "映像の種類 (#806)。録画を始めたときの番組の映像の解像度から決める。分からなければ、チャンネル種別から決める。"
  videoFormat: VideoFormat!
  "録画を始めたときの予約のジャンル。時刻予約の録画や、取り込んだ録画では空になる (#468)。"
  genres: [Genre!]!
  "録画を始めたときに予約に一致していたルール (最も古いもの)。番組予約と時刻予約の録画や、ルールを消したときは null。"
  rule: Rule
  "録画を始めたときに一致していたルールの名前。ルールを消しても残る。ルールで録っていなければ null。"
  ruleName: String
  "録画中に番組が EPG から消えたかどうか。"
  programLost: Boolean!
  "録画中の TS の EIT[p/f] で、予約した番組が放送中になった日時と、放送中でなくなった日時 (設計書 5.1)。分からなければ null。"
  broadcastStartedAt: Time
  broadcastEndedAt: Time
  "予約した番組が、予定の時間に放送されなかったかどうか。録った TS は残す。遅れて始まるのを待った番組が延長の上限まで放送中にならなかったときは、前の番組の TS を残さず、録画は失敗になる (#1046)。"
  notBroadcast: Boolean!
  "録画中の録画の、書いているセグメントの様子 (#829)。mikan が 10 秒ごとに書く。録画中でないか、まだ書いていなければ null。"
  liveStats: RecordingLiveStats
  "実際に録画を始めた日時と、終えた日時。録画中なら終えた日時は null。"
  recordedFrom: Time!
  recordedUntil: Time
  "名前の順。"
  tags: [Tag!]!
  files: [RecordingFile!]!
  "ログイン中のユーザーの再生位置 (ミリ秒)。再生していなければ null。"
  watchPositionMs: Int64
  "代表画像の URL のパス。画像をまだ作っていなければ null。tenban にマウントしたプールから配信する。"
  thumbnailUrl: String
  """
  シークバー用のプレビュー画像の URL のパス。画像をまだ作っていなければ null。
  コマの並びは、同じディレクトリの preview.json に書く (末尾の preview.jpg を preview.json に変えた URL で取れる)。
  """
  previewUrl: String
  """
  ログイン中のユーザーが前回見た位置に合う、プレビュー画像のコマ。再生位置より前で、いちばん近いコマを選ぶ (先の場面を見せない)。
  再生していないか、見終えている (終わりの 10 秒前より後まで見た) か、再生位置より前にコマがないか、プレビュー画像がなければ null。
  """
  watchFrame: PreviewFrame
  """
  録画の時間帯の実況の過去ログを返す URL のパス (設計書 7.4)。tenban が過去ログ API から取って中継する。
  録画したサービスに実況のチャンネルがなければ、空の一覧を返す。
  """
  jikkyoCommentsUrl: String!
  "同じ話の別の放送の実況の過去ログを読む URL のパス (#1361)。"
  jikkyoOtherCommentsUrl: String!
  "上映会のコメント (NICOLOG) を読む URL のパス (#1363)。"
  jikkyoNicologCommentsUrl: String!
  """
  録画の TS を流す URL のパス (設計書 7.2)。ログイン中のセッションで使う。末尾に ?start=秒 を付けると、その位置から流す。
  外部プレイヤーには、createStreamURL で署名付きの URL を発行する。
  """
  streamUrl: String!
}

type RecordingEdge {
  cursor: String!
  node: Recording!
}

type RecordingConnection {
  edges: [RecordingEdge!]!
  pageInfo: PageInfo!
}

"""
まとめて行った操作の結果 (#471)。
"""
type BulkOperationPayload {
  "操作した数。"
  processed: Int!
  "保護しているか、録画中か、見つからないなどで、操作しなかった数。"
  skipped: Int!
}

"""
録画の絞り込み。省いた条件は絞り込まない。
"""
input RecordingFilter {
  "どれかのタグが付いた録画。"
  tagIds: [ID!]
  states: [RecordingState!]
  serviceIds: [ID!]
  "番組名に含む文字列。大文字と小文字を区別しない。"
  keyword: String
  "放送の開始がこの日時以降の録画。"
  since: Time
  "放送の開始がこの日時より前の録画。"
  until: Time
  "このルールで録った録画 (#468)。"
  ruleId: ID
  "ジャンルの大分類 (lv1) のどれかに当たる録画。"
  genres: [Int!]
}

"""
録画の並び順。どちらも、録画を始めた日時で並べる。
"""
enum RecordingOrder {
  NEWEST_FIRST
  OLDEST_FIRST
}

extend type Query {
  "録画を、録画を始めた日時の順 (既定は新しい順) に first 件まで返す。"
  recordings(first: Int! = 50, after: String, filter: RecordingFilter, order: RecordingOrder! = NEWEST_FIRST): RecordingConnection!
  """
  ログイン中のユーザーが途中まで見た録画を、最後に見た新しい順に first 件まで返す (続きから見る)。
  少しだけ見た録画 (10 秒より前) と、終わりの 10 秒以内まで見た録画は、見終えたものとして含めない。
  """
  continueWatching(first: Int! = 12): [Recording!]!
  "タグを、名前の順に返す。"
  tags: [Tag!]!
}

extend type Mutation {
  """
  録画を消し、消した録画の ID を返す。録画ファイルと生成物も消すが、録画履歴は残す。視聴者は使えない (設計書 9.7)。
  保護した録画と、録画中の録画は消さずに CONFLICT を返す。
  """
  deleteRecording(id: ID!): ID!
  """
  録画 ids をまとめて消す (#471)。視聴者は使えない。1 件ずつ deleteRecording と同じく消し、監査ログも 1 件ずつ残す。
  保護した録画、録画中の録画、見つからない録画は、消さずに飛ばした数に数える。一度に 500 件まで。
  """
  deleteRecordings(ids: [ID!]!): BulkOperationPayload!
  "録画に保護の印を付けるか、外す。視聴者は使えない。"
  setRecordingProtected(id: ID!, protected: Boolean!): Recording!
  "録画のタグを置き換える。ないタグは作る。視聴者は使えない。"
  setRecordingTags(id: ID!, tags: [String!]!): Recording!
  "ログイン中のユーザーの再生位置 (ミリ秒) を保存する。誰でも使える。"
  saveWatchPosition(id: ID!, positionMs: Int64!): Recording!
  "ログイン中のユーザーの再生位置を消し、続きから見るの一覧から外す (#1074)。誰でも使える。"
  clearWatchPosition(id: ID!): Recording!
  "ログイン中のユーザーの再生位置をすべて消し、消した件数を返す (#1366)。誰でも使える。"
  clearAllWatchPositions: Int!
  """
  録画の代表画像とプレビュー画像を作り直すジョブを入れる (設計書 6.1)。視聴者は使えない。
  作り直すまでは、今の画像を出す。同じ録画のジョブを待っていれば、重ねて入れずに false を返す。
  """
  regenerateRecordingImages(id: ID!): Boolean!
  """
  録画のファイルを読み直し、索引とドロップなどの集計を作り直すジョブを入れる (設計書 6.1、#476)。視聴者は使えない。
  終われば、代表画像とプレビュー画像も作り直す。録画中の録画は CONFLICT にする。
  同じ録画のジョブを待っていれば、重ねて入れずに false を返す。
  """
  reanalyzeRecording(id: ID!): Boolean!
  """
  録画の CM とみなす区間を見分けるジョブを入れる (設計書 6.1、#1209)。視聴者は使えない。全体や予約の設定にかかわらず見分け、
  前に見分けた区間は置き換える。録画中の録画と、TS のセグメントのない録画は CONFLICT にする。
  同じ録画のジョブを待っていれば、重ねて入れずに false を返す。
  """
  detectRecordingCm(id: ID!): Boolean!
}

"""
プレビュー画像 (preview.jpg) から切り出す 1 コマ。画面は、url の画像を背景にして、(x, y) から width × height を見せる。
"""
type PreviewFrame {
  "プレビュー画像の URL のパス。"
  url: String!
  x: Int!
  y: Int!
  width: Int!
  height: Int!
  "プレビュー画像全体の大きさ。背景を縮めて描くときに使う。"
  sheetWidth: Int!
  sheetHeight: Int!
}

"""
PID の種類。PMT に書かれたストリーム (映像、音声、そのほか) と、PSI と SI の表。PMT にも決まった PID にもなければ UNKNOWN。
"""
enum StreamKind {
  VIDEO
  AUDIO
  OTHER
  PSI
  UNKNOWN
}

"""
PID ごとの品質の集計 (#473)。
"""
type StreamQuality {
  pid: Int!
  kind: StreamKind!
  packets: Int64!
  drops: Int64!
  errors: Int64!
  scrambled: Int64!
  "PMT の stream_type (#827)。0x02 は MPEG-2 映像、0x1B は H.264、0x24 は HEVC、0x0F は AAC など。PMT に載っていない PID と、記録する前に録った録画では null。"
  streamType: Int
  "ストリーム識別記述子の component_tag (#827)。EPG の映像と音声のコンポーネントと対応づける。記述子がなければ null。"
  componentTag: Int
}

"""
録画中の録画の、書いているセグメントの様子 (#829)。
"""
type RecordingLiveStats {
  "直前の 10 秒ほどに書いたビットレート (bps)。"
  bitrate: Int64!
  "書いているセグメントのバイト数と、ドロップ、エラー、スクランブルの数。閉じたセグメントの数は、Recording の drops などにある。"
  bytes: Int64!
  drops: Int64!
  errors: Int64!
  scrambled: Int64!
  updatedAt: Time!
}
