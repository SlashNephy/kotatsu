"""
録画設定 (設計書 4.7)。全体の既定値に、ルールや予約の上書きを重ねる。
"""
type RecordingSettings {
  "保存先プール。null なら、推定サイズが収まるプールを選ぶ。"
  poolId: String
  "ファイル名の text/template"
  fileNameTemplate: String!
  startMarginSeconds: Int!
  endMarginSeconds: Int!
  "優先度 (-10〜10)。チューナーが足りないときは、高い予約から割り当てる。"
  priority: Int!
  "引き継ぎや再起動で分かれた録画のファイルを、録画が終わったら 1 つにつなぐかどうか (設計書 5.4)"
  joinSegments: Boolean!
  "録画が終わったら、CM とみなす区間を見分けるかどうか (設計書 6.1、#1209)。既定は false。"
  detectCm: Boolean!
  "録画が終わったら、録画を変換して MP4 を足すときの画質 (設計書 6.1、#1253)。null なら変換しない。既定は null。"
  transcodePreset: String
  "録画を変換するときに出すコマ数 (#1509)。auto (映像から測って 30 か 60 を選ぶ)、30、60 のどれか。既定は auto。"
  transcodeFrameRate: String!
}

"""
ルールを作るときの既定値 (設計書 4.2、#470)。ルールの作成の画面の初期値に使う。
"""
type RuleDefaults {
  "同じ番組名を録画済みなら予約しないかどうか (設計書 4.4)。"
  avoidDuplicates: Boolean!
  "重複を避ける期間 (日)。null なら期間を区切らない。"
  duplicateWindowDays: Int
  "イベントリレーで続く番組も予約するかどうか (設計書 4.6)。"
  followEventRelay: Boolean!
  "局をまたいで同じ回を束ね、最初の放送だけを予約するかどうか (設計書 4.4、#1498)。"
  bundleSameEpisodes: Boolean!
}

"""
ルールを作るときの既定値の変える項目。省いた項目は変えない。
"""
input RuleDefaultsInput {
  avoidDuplicates: Boolean
  "重複を避ける期間 (1〜3650 日)。"
  duplicateWindowDays: Int
  "重複を避ける期間を区切らないようにする。duplicateWindowDays と一緒には使えない。"
  clearDuplicateWindowDays: Boolean! = false
  followEventRelay: Boolean
  bundleSameEpisodes: Boolean
}

"""
画面から変える、全体の設定 (設計書 11.2)。
"""
type SystemSettings {
  "録画設定の全体の既定値。"
  recordingDefaults: RecordingSettings!
  "過去の番組の保持期間 (日)。0 なら無期限。"
  archiveRetentionDays: Int!
  "配り終えた通知の保持期間 (日)。既読か未読かにかかわらず、これより古い通知を消す。0 なら無期限。"
  notificationRetentionDays: Int!
  "録画の再生位置の保持期間 (日)。最後に更新してからこれより経った再生位置を消す。0 なら無期限。"
  watchProgressRetentionDays: Int!
  "外部との通信を記録するかどうか (#1369)。"
  networkActivityEnabled: Boolean!
  "外部との通信の記録の保持期間 (日)。"
  networkActivityRetentionDays: Int!
  "ルールを作るときの既定値。"
  ruleDefaults: RuleDefaults!
  "MCP のクライアントに、認可サーバーと MCP サーバーを使わせるかどうか (#963)。既定は false。"
  mcpEnabled: Boolean!
  """
  データ放送の文書の双方向の通信 (投票やプレゼントの応募など) を、tenban が中継するかどうか (#501)。既定は false。
  ログインしていれば誰でも読め、ライブ視聴の画面が、データ放送に通信の機能を渡すかを決めるのに使う。
  """
  dataBroadcastIpEnabled: Boolean!
  """
  外部プレイヤー (VLC や mpv) 用の署名付きの映像の URL を、発行し、受け付けるかどうか (#1755、設計書 7.6)。既定は false。
  無効の間は、createStreamURL が FORBIDDEN を返し、発行済みの URL も期限の前に断る。
  ログインしていれば誰でも読め、画面が、URL を発行する操作を出すかを決めるのに使う。
  """
  externalPlayerUrlsEnabled: Boolean!
  """
  IPTV のクライアント (Kodi、Jellyfin、Plex など) 用の URL を、発行し、受け付けるかどうか (#1755、設計書 9.8)。既定は false。
  無効の間は、createIptvFeed が FORBIDDEN を返し、取り消していない URL も断る。取り消す (deleteIptvFeed) ことはできる。
  ログインしていれば誰でも読め、画面が、URL を発行する操作を出すかを決めるのに使う。
  """
  iptvFeedsEnabled: Boolean!
  "しょぼいカレンダー、Annict、AniList との連携 (アニメの番組と作品の結びつき) を使うかどうか (設計書 3.8)。既定は false。"
  animeLinkingEnabled: Boolean!
  """
  NX-Jikkyo のソースをオプトインしているかどうか (設計書 7.4)。既定は false。
  ログインしていれば誰でも読め、実況の画面を出すかを決めるのに使う。
  """
  jikkyoEnabled: Boolean!
  "管理者がオプトインした実況のコメントのソース (#1405)。既定は空。ログインしていれば誰でも読める。"
  commentSources: [CommentSource!]!
  "字幕の外字 (DRCS) を文字に置き換える表 (#825)。MD5 の順に並べる。"
  drcsReplacements: [DrcsReplacement!]!
  """
  ライブ視聴しているサービスを、視聴している間だけタイムシフトで録るかどうか (設計書 5.7、#1408)。既定は false。
  ログインしていれば誰でも読め、ライブ視聴の画面が、バッファを読み直すかを決めるのに使う。
  """
  timeshiftWhileWatching: Boolean!
  "視聴している間だけ録るサービスの保持時間 (秒)。600〜86400。既定は 3600。"
  timeshiftWhileWatchingRetentionSeconds: Int!
  """
  どのルールにも一致しなくなったルール予約を、消さずに残す放送前の時間 (分。設計書 4.3、#1501)。0〜1440。既定は 180。
  番組表は放送の直前まで書き換わるので、その拍子に外れた予約を消して録り逃さないようにする。ルールを消すか無効にしたときは、この時間の内でも消す。
  """
  ruleUnmatchedGraceMinutes: Int!
  "最後に変えた日時。一度も変えていなければ null。"
  updatedAt: Time
}

"""
全体の設定の変える項目。省いた項目は変えない。
"""
input SystemSettingsInput {
  "録画設定の既定値の変える項目。省いた項目は変えない。"
  recordingDefaults: RecordingSettingsOverridesInput
  archiveRetentionDays: Int
  notificationRetentionDays: Int
  watchProgressRetentionDays: Int
  networkActivityEnabled: Boolean
  networkActivityRetentionDays: Int
  "ルールを作るときの既定値の変える項目。省いた項目は変えない。"
  ruleDefaults: RuleDefaultsInput
  mcpEnabled: Boolean
  "変えるには、直近 10 分以内の認証が要る。文書が送る受信機の情報 (郵便番号など) が、外部のサーバーに届くようになるため。"
  dataBroadcastIpEnabled: Boolean
  "変えるには、直近 10 分以内の認証が要る。URL を持つ人が、そのユーザーとして映像を見られるようになるため。"
  externalPlayerUrlsEnabled: Boolean
  "変えるには、直近 10 分以内の認証が要る。URL を持つ人が、そのユーザーとしてライブ視聴を見られるようになるため。"
  iptvFeedsEnabled: Boolean
  "変えるときは、外部へ問い合わせ始めるかどうかを決める操作なので、直近 10 分以内の認証が要る (設計書 9.5)。"
  animeLinkingEnabled: Boolean
  "渡したら、オプトインする実況のコメントのソースを置き換える (#1405)。外部へ問い合わせ始めるかどうかを決める操作なので、直近 10 分以内の認証が要る (設計書 9.5)。"
  commentSources: [CommentSource!]
  """
  字幕の外字の置き換えの表の変更。書いた外字だけを変え (text が null なら消し)、ほかは変えない。表は 2000 件まで。
  表を丸ごと送らせないのは、別の画面や管理者が同時に登録したものを、古い表で上書きして消さないためである。
  """
  drcsReplacements: [DrcsReplacementInput!]
  "有効にするには、この tenban にタイムシフトのディレクトリが要る。なければ CONFLICT を返す。"
  timeshiftWhileWatching: Boolean
  "600〜86400 秒。"
  timeshiftWhileWatchingRetentionSeconds: Int
  "0〜1440 分。"
  ruleUnmatchedGraceMinutes: Int
}

"""
字幕の外字 (DRCS) を文字に置き換える表の 1 行 (#825)。
"""
type DrcsReplacement {
  "外字の画像の MD5 (小文字の 32 桁の 16 進)。aribb24.js が置き換えに使う鍵と同じ。"
  md5: String!
  "置き換える文字。1〜4 文字。外字の 1 文字の枠に縮めて描く。"
  text: String!
}

input DrcsReplacementInput {
  md5: String!
  "置き換える文字。null なら、この外字を表から消す。"
  text: String
}

extend type Query {
  "字幕の外字の置き換えの表 (#825)。ログインしていれば、誰でも読める。字幕の履歴とコピー、映像に重ねる字幕で使う。"
  drcsReplacements: [DrcsReplacement!]!
  "録画を終えた後の変換 (#1253) で選べる画質の名前。"
  transcodePresets: [String!]!
}

"""
チャンネル種別の表示の変える項目。省いた項目は変えない。
"""
input ChannelTypeInput {
  "表示名。1〜32 文字。"
  displayName: String
  "並び順。小さいほど前に並ぶ。0〜10000。"
  sortOrder: Int
}

"""
サービスの表示の変える項目。省いた項目は変えない。
"""
input ServiceInput {
  "番組表に出さない印"
  hidden: Boolean
  "並び順の上書き。小さいほど前に並ぶ。0〜10000。"
  sortOrder: Int
  "並び順の上書きを消し、リモコンのキーの順に戻す。sortOrder と一緒には使えない。"
  resetSortOrder: Boolean! = false
}

"""
保存先プールの設定の変える項目。省いた項目は変えない。
"""
input StoragePoolInput {
  "-1000〜1000。"
  priority: Int
  "0 以上。0 なら、容量の管理で録画を消さない。"
  minFreeBytes: Int64
}

extend type Query {
  "全体の設定。ログイン中のユーザーなら誰でも読める。"
  systemSettings: SystemSettings!
}

extend type Mutation {
  """
  全体の設定を変える。管理者だけが使え、直近 10 分以内の認証が要る (設計書 9.5、9.7)。
  正しくない値なら、BAD_USER_INPUT を返す。
  """
  updateSystemSettings(input: SystemSettingsInput!): SystemSettings!

  """
  チャンネル種別 type の表示名と並び順を変える (設計書 3.1)。管理者だけが使え、直近 10 分以内の認証が要る (設計書 9.5、9.7)。
  種別がなければ NOT_FOUND を、正しくない値なら BAD_USER_INPUT を返す。
  """
  updateChannelType(type: String!, input: ChannelTypeInput!): ChannelType!

  """
  サービス id の、番組表に出さない印と並び順の上書きを変える (設計書 8.2、10.3)。管理者だけが使え、直近 10 分以内の認証が要る (設計書 9.5、9.7)。
  サービスがなければ NOT_FOUND を、正しくない値なら BAD_USER_INPUT を返す。
  """
  updateService(id: ID!, input: ServiceInput!): Service!

  """
  保存先プール id の優先順位と容量の閾値を変える (設計書 5.6、6.1)。管理者だけが使え、直近 10 分以内の認証が要る (設計書 9.5、9.7)。
  このインスタンスにマウントされていないプールなら NOT_FOUND を、正しくない値なら BAD_USER_INPUT を返す。
  """
  updateStoragePool(id: String!, input: StoragePoolInput!): StoragePool!
}

"実況のコメントのソース (#1405)。"
enum CommentSource {
  "NX-Jikkyo のライブのコメントと、過去ログ API の過去ログ"
  NX_JIKKYO
  "NICOLOG のニコニコ生放送の上映会のコメント"
  NICOLOG
}
