"""
監査ログの記録 (設計書 8.5)。誰が何をしたかを残す。
一覧から読むだけなので、node で引き直すことはできない。
"""
type AuditEvent {
  id: ID!
  occurredAt: Time!
  actor: AuditActor!
  "操作の種類 (user.created など)。"
  action: String!
  "対象の種類 (user、rule など) と ID。"
  targetType: String!
  targetId: String
  "変更の要約。JSON の文字列。"
  summary: String!
  "送信元。システムの操作では null。"
  sourceIp: String
  userAgent: String
  "MCP のクライアントを経由した操作なら、クライアントの ID (クライアントのメタデータの URL)。ほかの操作では null。"
  client: String
}

"""
監査ログの操作者。ユーザーの操作か、システムのロールの操作か。
"""
type AuditActor {
  "user か system。"
  type: String!
  "ユーザーの操作なら、そのユーザー。ユーザーを消していれば null。"
  user: User
  "システムの操作なら、ロールの名前 (neko など)。"
  role: String
}

type AuditEventEdge {
  cursor: String!
  node: AuditEvent!
}

type AuditEventConnection {
  edges: [AuditEventEdge!]!
  pageInfo: PageInfo!
}

"""
監査ログの絞り込み。省いた項目は絞り込まない。
"""
input AuditEventFilter {
  "操作の種類の先頭 (user. ならユーザーの操作だけ)。"
  actionPrefix: String
  actorUserId: ID
  targetType: String
  targetId: String
  "この日時以降の記録だけを返す。"
  since: Time
  "この日時より前の記録だけを返す。"
  until: Time
}

"""
各ロールのインスタンス (設計書 1.4)。
"""
type Instance {
  "インスタンスの ID。all では、1 つのプロセスがロールごとに同じ ID で登録する。"
  instanceId: String!
  role: String!
  "ほかのインスタンスから届くアドレス (host:port)。"
  address: String!
  startedAt: Time!
  heartbeatAt: Time!
  "最近ハートビートを書いたかどうか。止まったインスタンスは、しばらく残してから消す。"
  alive: Boolean!
}

"""
リーダー選出のリース (設計書 1.4)。neko のリースを持つインスタンスだけがアクティブになる。
"""
type Lease {
  name: String!
  "リースを持っているインスタンスの ID。"
  holderInstanceId: String!
  generation: Int!
  acquiredAt: Time!
  expiresAt: Time!
  "期限が切れていないかどうか。"
  valid: Boolean!
}

"""
チューナーサーバーの状態 (設計書 3.7)。
"""
type TunerServerStatus {
  "接続できない縮退中かどうか。"
  degraded: Boolean!
  degradedSince: Time
  "最後に接続に失敗した理由。"
  lastError: String!
  "チューナーサーバーの時計と OS の時計の差 (ミリ秒)。分からなければ null。"
  clockSkewMs: Int
  "時計の差が、警告する閾値を超えているかどうか。"
  clockSkewed: Boolean!
  "時計の差を警告する閾値 (ミリ秒)。"
  clockSkewThresholdMs: Int!
  checkedAt: Time!
}

"""
チューナー (設計書 3.1)。
"""
type Tuner {
  index: Int!
  name: String!
  "受信できるチャンネル種別。"
  types: [String!]!
  available: Boolean!
  remote: Boolean!
  fault: Boolean!
}

"""
保存先プール (設計書 5.6)。
"""
type StoragePool {
  id: String!
  "このインスタンスでのマウント先。"
  path: String!
  "選ばれる優先順位。大きいほど先に選ぶ。"
  priority: Int!
  "容量の閾値 (バイト)。空き容量がこれを下回ったら、保護されていない古い録画から消す。0 なら消さない。"
  minFreeBytes: Int64!
  "このインスタンスから見た空き容量 (バイト)。調べられなければ null。"
  freeBytes: Int64
  "このインスタンスから見た、ファイルシステムの容量 (バイト)。root のために取っておく分も含む。調べられなければ null。"
  totalBytes: Int64
}

"""
理由ごとの、録画の失敗の累計 (設計書 5.5)。録画を消しても減らない。
"""
type RecordingFailureCount {
  reason: RecordingFailureReason!
  count: Int64!
  "最後に失敗した日時。一度も失敗していないか、累計を 0 に戻してから失敗していなければ null。"
  lastFailedAt: Time
  "管理者が累計を 0 に戻した日時 (#1035)。戻していなければ null。"
  resetAt: Time
}

"""
システムの状態。
"""
type SystemStatus {
  instances: [Instance!]!
  leases: [Lease!]!
  "チューナーサーバーの状態。まだ確かめていなければ null。"
  tunerServer: TunerServerStatus
  tuners: [Tuner!]!
  pools: [StoragePool!]!
  "理由ごとの、録画の失敗の累計。"
  recordingFailures: [RecordingFailureCount!]!
}

extend type Mutation {
  """
  理由 reasons の、録画の失敗の累計を 0 に、最後に失敗した日時を空に戻し、戻した後の累計を返す (#1035)。
  検証で失敗させた分や、直した障害の分を消すのに使う。理由ごとに監査ログに残す。管理者だけが使える (設計書 9.7)。
  """
  resetRecordingFailureCounts(reasons: [RecordingFailureReason!]!): [RecordingFailureCount!]!
}

extend type Query {
  "監査ログを、新しい順に first 件まで返す。管理者だけが使える (設計書 9.7)。"
  auditEvents(first: Int! = 50, after: String, filter: AuditEventFilter): AuditEventConnection!
  "システムの状態。管理者だけが使える (設計書 9.7)。"
  systemStatus: SystemStatus!
}

"""
チューナーサーバーにつながっているかどうか (設計書 3.7)。ログイン中の誰でも読め、画面に縮退中であることを示すのに使う。
理由などの詳しいことは、管理者向けの systemStatus で返す。
"""
type TunerServerHealth {
  "接続できない縮退中かどうか。まだ確かめていなければ false。"
  degraded: Boolean!
  "縮退が始まった日時。縮退中でなければ null。"
  degradedSince: Time
  "チューナーサーバーの時計の差が、警告する閾値を超えているかどうか。録画の開始と終了がずれうる。"
  clockSkewed: Boolean!
  "チューナーサーバーの時計と OS の時計の差 (ミリ秒)。分からなければ null。"
  clockSkewMs: Int
}

extend type Query {
  "チューナーサーバーにつながっているかどうか (設計書 3.7)。ログイン中の誰でも読める。"
  tunerServerHealth: TunerServerHealth!
}

extend type Query {
  """
  保存先プールの名前 (ID) を、昇順に返す。ログイン中の誰でも読め、予約とルールで保存先を選ぶのに使う (設計書 5.6、#463)。
  マウント先や空き容量は、管理者向けの systemStatus で返す。
  """
  storagePoolNames: [String!]!
}
