"ライブラリの種類 (設計書 5.8)。"
enum LibraryKind {
  "保存先プール。設定に書かなくても、ライブラリとして見せる。"
  POOL
  "設定 (storage.libraries) で足したフォルダ。"
  FOLDER
  """
  管理者が接続した Google Drive (#1902)。接続しているときだけ出す。パスは、名前でなく、マイドライブ (root) か共有ドライブの ID と、
  フォルダとファイルの ID を / でつないだもの。
  """
  GOOGLE_DRIVE
}

"""
録画として登録していない TS を、ファイラーで選んで再生してよいフォルダ (設計書 5.8、#1734)。
録画と同じく、ログインした家族全員が使える。
"""
type Library {
  "ライブラリの名前。"
  name: String!
  kind: LibraryKind!
}

"ライブラリのディレクトリの中のファイルかディレクトリ。"
type LibraryEntry {
  name: String!
  "ライブラリの中の / 区切りの相対パス。"
  path: String!
  "ディレクトリかどうか。"
  directory: Boolean!
  "ファイルの大きさ (バイト)。ディレクトリでは 0。"
  size: Int64!
  "最後に書いた日時。"
  modifiedAt: Time!
  "TS として再生できるファイル (拡張子が .ts、.m2ts、.mts のもの) かどうか。"
  playable: Boolean!
}

"ライブラリのディレクトリの中身。"
type LibraryDirectory {
  library: Library!
  "ライブラリの中の / 区切りの相対パス。根元は空。"
  path: String!
  """
  パスの段ごとの、画面に出す名前。パンくずに使う。フォルダのライブラリでは段そのもの、Google Drive ではフォルダの名前
  (マイドライブの根元は "My Drive")。根元なら空。
  """
  names: [String!]!
  """
  中のディレクトリと、再生できるファイルを、ディレクトリ、ファイルの順に、それぞれ名前の順に返す。
  隠しファイル、再生できないファイル、ライブラリの外を指すシンボリックリンクは返さない。
  """
  entries: [LibraryEntry!]!
}

"ライブラリのファイルのシークの索引の進み具合 (設計書 5.8)。"
type LibraryFileIndex {
  "索引を作り終えたかどうか。作り終えるまでは、読み直して進み具合を確かめる。"
  complete: Boolean!
  """
  ファイルを書いている途中とみなして、索引を作らないかどうか (最後に書いてから 1 分たっていないファイル)。
  索引がなければ、頭から再生できるだけで、シークできない。
  """
  writing: Boolean!
  "シークできる所 (索引のできた最後の I フレームの位置。ファイルの始まりからの秒)。索引がまだなければ 0。"
  seekableSeconds: Float!
  """
  再生の時間 (秒)。作り終えていれば索引から求め、作っている途中なら、できた所までのバイト数と時間の比から見込む。
  索引がまだなければ null。
  """
  durationSeconds: Float
}

"ライブラリの、再生できるファイル。"
type LibraryFile {
  "ライブラリの名前、パス、大きさ、更新日時から作った ID。ファイルを書き換えると変わる。"
  id: ID!
  """
  ファイルの ID (ライブラリの名前、パス、大きさ、更新日時から作った 32 桁の 16 進数)。id と違って短く、パスを含まないので、
  端末に保存するときの名前に使う (設計書 7.8)。ファイルを書き換えると変わる。
  """
  fileId: String!
  library: Library!
  "ライブラリの中の / 区切りの相対パス。"
  path: String!
  name: String!
  size: Int64!
  modifiedAt: Time!
  "ファイルの頭から読んだ映像の種類。読めなければ HD とみなす。"
  videoFormat: VideoFormat!
  index: LibraryFileIndex!
  "ログイン中のユーザーが保存した再生位置 (ミリ秒)。ファイルを書き換えたら、前の位置は使わない。"
  watchPositionMs: Int64
  "ファイルの TS を流す URL のパス (設計書 7.2)。ログイン中のセッションで使う。start=秒 を足して位置を指定する。"
  streamUrl: String!
  """
  TS の中の SDT、EIT[p/f]、TOT から読んだ放送の情報 (局、放送の時刻、番組)。索引を作り始めるときに読む。
  まだ読んでいないか、読めなければ null。
  """
  broadcast: LibraryBroadcast
  "放送中だった番組の音声の構成。索引を作り終えるまでと、読めなければ空。"
  audios: [ProgramAudio!]!
  "ドロップなどの集計。索引を作り終えるまでは null。"
  quality: LibraryFileQuality
  """
  ファイルの時間帯の実況の過去ログの URL のパス (設計書 7.4)。局と時間帯は broadcast のものを使う。
  コメントの時刻は、broadcast.recordedFrom からの秒。ログイン中のセッションで使う。
  """
  jikkyoCommentsUrl: String!
  """
  代表画像の URL のパス。索引を作り終えた後に、nekonote のジョブで作る (設計書 5.8)。まだなければ null で、開くとジョブを入れる。
  """
  thumbnailUrl: String
  "シークバー用のプレビュー画像の URL のパス。代表画像と一緒に作る。まだないか、作らない設定なら null。"
  previewUrl: String
  """
  CM とみなした区間 (設計書 5.8)。索引を作り終えた後に、nekonote のジョブで、録画と同じ見分け方で見分ける。
  まだ見分けていなければ null で、開くとジョブを入れる。見つからなければ空のリスト。
  """
  cmSections: [LibraryCMSection!]
  """
  音声から自動生成した字幕 (設計書 5.8)。録画と同じく、頼まれたときだけ生成する。生成していなければ空。
  今のファイルから生成したものだけを返す。
  """
  autoCaptions: [LibraryAutoCaption!]!
  "字幕の自動生成の状態。録画と同じ形で返す。"
  autoCaptionsStatus: RecordingAutoCaptions!
  """
  ファイルを kyusu で変換して流す仮想 HLS の、元の URL のパス (設計書 7.3)。
  後ろに /hls/{画質}/{音声}/playlist.m3u8 を付けて使う。ログイン中のセッションで使う。
  """
  hlsUrl: String!
}

"ライブラリのファイルの、TS の中から読んだ放送の情報 (設計書 5.8)。録画の取り込み (設計書 6.5) と同じく読む。"
type LibraryBroadcast {
  "SDT[actual] の original_network_id。読めなければ null。"
  networkId: Int
  "映像を持つ最初のサービスのサービス ID。"
  serviceId: Int!
  "SDT[actual] のサービス名。読めなければ空。"
  serviceName: String!
  "同じネットワークとサービス ID の Kotatsu のサービス。なければ null (引っ越す前の地域の局など)。"
  service: Service
  """
  同梱の対応表で引いた実況のチャンネルの ID。Kotatsu のサービスがなくても引く。
  対応するチャンネルがないか、全体の設定で実況を切っていれば null。
  """
  jikkyoChannelId: String
  """
  頭で最初に読んだ TOT の時刻。再生の 0 秒をこの時刻とみなす (取り込んだ録画と同じく、数秒ずれることがある)。読めなければ null。
  """
  recordedFrom: Time
  "終わりで最後に読んだ TOT の時刻。読めなければ null。"
  recordedUntil: Time
  "録った範囲に最も長く重なる番組。読めなければ null。"
  program: LibraryProgram
}

"ライブラリのファイルの、EIT[p/f] で読んだ番組。"
type LibraryProgram {
  eventId: Int!
  name: String!
  description: String!
  extended: [ExtendedItem!]!
  "番組の開始。未定なら null。"
  startAt: Time
  "番組の終わり。未定なら null。"
  endAt: Time
}

"ライブラリのファイルのドロップなどの集計。録画の解析と同じく数える。"
type LibraryFileQuality {
  drops: Int64!
  errors: Int64!
  scrambled: Int64!
}

extend type Query {
  "このインスタンスから読めるライブラリを、保存先プール (設定の順)、フォルダ (名前の順) の順に返す。"
  libraries: [Library!]!
  """
  ライブラリ library の、ディレクトリ path (根元は空) の中身を返す。
  ライブラリかディレクトリがなければ NOT_FOUND を、パスがライブラリの外を指すなら BAD_USER_INPUT を返す。
  """
  libraryDirectory(library: String!, path: String!): LibraryDirectory!
  """
  ライブラリ library の、再生できるファイル path を返す。シークの索引を作り終えていなければ、裏で作り始める。
  ファイルがないか再生できるファイルでなければ NOT_FOUND を、Blu-ray の 192 バイトのパケットの .m2ts のように TS でなければ BAD_USER_INPUT を返す。
  """
  libraryFile(library: String!, path: String!): LibraryFile!
  """
  ライブラリ library の、ディレクトリ path (根元は空) の下から、名前に query を含む再生できるファイルを、名前の順に 100 件まで返す (#1902)。
  query は前後の空白を除いて 1〜100 文字。フォルダのライブラリは、名前の部分一致 (大文字と小文字を区別しない) で下をたどる。
  Google Drive は、Drive の名前の検索 (name contains) で探し、path の下にあるものだけを返す。
  """
  librarySearch(library: String!, path: String!, query: String!): LibrarySearchResult!
}

"ライブラリの名前の検索の結果 (#1902)。"
type LibrarySearchResult {
  "見つけたファイル。"
  entries: [LibraryEntry!]!
  "件数の上限や、たどる数の上限で、探すのを打ち切ったかどうか。打ち切ったら、語を足して絞るよう出す。"
  truncated: Boolean!
}

extend type Mutation {
  """
  ログイン中のユーザーの、ライブラリのファイル id (LibraryFile.id) の再生位置 (ミリ秒) を保存する。誰でも使える。
  id を引いた後にファイルを書き換えていたら、前のファイルの位置なので保存せず、今のファイルを返す。
  """
  saveLibraryWatchPosition(id: ID!, positionMs: Int64!): LibraryFile!
  """
  ライブラリのファイル id (LibraryFile.id) の音声から字幕を自動生成するジョブを入れる (設計書 5.8)。視聴者は使えない。
  録画と同じく、前に生成した字幕は、生成し終えたら置き換える。同じファイルのジョブを待っていれば、重ねて入れない。
  id を引いた後にファイルを書き換えていたら CONFLICT にする。書いている途中か、音声を引くサービスが分からないファイルも CONFLICT にする。
  """
  generateLibraryCaptions(id: ID!): LibraryFile!
}

"ライブラリのファイルの、CM とみなした区間。時刻は、再生の 0 秒 (索引の最初の I フレーム) からの秒。"
type LibraryCMSection {
  startSeconds: Float!
  endSeconds: Float!
}

"ライブラリのファイルの音声から自動生成した字幕の 1 つ。時刻は、再生の 0 秒 (最初の I フレーム) からの秒。"
type LibraryAutoCaption {
  startSeconds: Float!
  endSeconds: Float!
  "字幕の本文。複数の行は改行でつなぐ。"
  text: String!
}
