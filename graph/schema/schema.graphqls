"""
日時。RFC 3339 の文字列で表す。
"""
scalar Time

"""
64 ビットの整数。ファイルや容量の大きさ (バイト) のように、32 ビットの Int に収まらない値に使う。
"""
scalar Int64

"""
ID で引けるもの (Relay の Global Object Identification)。
"""
interface Node {
  id: ID!
}

"""
一覧のページの情報 (Relay の Cursor Connections)。カーソルは中身を解釈せずに、そのまま次のリクエストに渡す。
"""
type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type Query {
  """
  ログイン中のユーザー。
  """
  viewer: User!
  """
  動いている Kotatsu の版。
  """
  version: AppVersion!
  """
  表示のタイムゾーン (設計書 8.1)。IANA の名前 (Asia/Tokyo など)。画面は、日時をこのタイムゾーンで表す。
  """
  timeZone: String!
}

"""
Kotatsu の版。
"""
type AppVersion {
  """
  リリースのタグの版 (1.2.3)。main のビルドなら edge、版を埋め込まないビルドなら dev。
  """
  version: String!
  """
  ビルドしたコミット。分からなければ null。
  """
  revision: String
  """
  コミットしていない変更を含むビルドかどうか。
  """
  modified: Boolean!
  """
  動いている版より新しいリリース (#506)。管理者にだけ返す。新しいリリースを確かめる設定 (update_check.enabled) を入れていないか、
  新しいリリースがないか、まだ確かめていなければ null。
  """
  latestRelease: Release
}

"""
Kotatsu のリリース。
"""
type Release {
  "リリースの版 (1.2.3)。"
  version: String!
  "GitHub のリリースのページの URL。"
  url: String!
  publishedAt: Time!
}

type Subscription {
  """
  接続を保つために、一定の間隔で届く今の時刻。
  """
  heartbeat: Time!
}
