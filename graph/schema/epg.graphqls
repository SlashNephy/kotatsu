"""
チャンネル種別 (設計書 3.1)。種別の文字列はチューナーサーバーが返すものをそのまま使い、表示名と並び順は管理者が変えられる。
"""
type ChannelType {
  type: String!
  displayName: String!
  sortOrder: Int!
}

"""
サービス (設計書 3.2)。
"""
type Service implements Node {
  id: ID!
  "ネットワーク ID"
  networkId: Int!
  "放送のサービス ID"
  serviceId: Int!
  name: String!
  channelType: ChannelType!
  "チャンネル (GR の物理チャンネルなど)"
  channel: String!
  remoteControlKeyId: Int
  "番組表に出さない印"
  hidden: Boolean!
  "並び順の上書き。小さいほど前に並ぶ。上書きしていなければ null で、リモコンのキーの順に並ぶ。"
  sortOrder: Int
  "ライブ視聴の TS を流す URL のパス (設計書 7.2)。ログイン中のセッションで使う。"
  streamUrl: String!
  "ロゴの画像の URL のパス。ログイン中のセッションで使う。放送がロゴを送っていなければ null。チューナーサーバーがまだ受信していなければ、URL は 404 を返す。"
  logoUrl: String
  "ニコニコ実況のチャンネル (設計書 7.4)。対応するチャンネルがないか、NX-Jikkyo が扱っていなければ null。"
  jikkyo: JikkyoChannel
}

"NX-Jikkyo の実況のチャンネル。"
type JikkyoChannel {
  "jk1 などの ID。NX-Jikkyo の WebSocket の URL に使う。"
  id: String!
  name: String!
}

"""
番組のジャンル。ARIB STD-B10 の content_nibble の大分類と中分類。
"""
type Genre {
  lv1: Int!
  lv2: Int!
}

"""
番組の音声。ARIB STD-B10 の音声コンポーネント記述子の内容。
"""
type ProgramAudio {
  "component_type。1 はシングルモノ、2 はデュアルモノ、3 はステレオ、9 は 5.1ch など。"
  componentType: Int!
  "主音声かどうか。"
  isMain: Boolean!
  "言語のコード (ISO 639-2)。デュアルモノでは、主音声と副音声の 2 つになる。"
  languages: [String!]!
  samplingRate: Int!
}

"""
番組の詳細の、見出しと本文の組。
"""
type ExtendedItem {
  heading: String!
  text: String!
}

"""
番組。放送中の番組と、これから放送される番組。
"""
type Program implements Node {
  id: ID!
  service: Service!
  eventId: Int!
  startAt: Time!
  endAt: Time!
  "延長などで終了時刻が未定かどうか。未定のときの endAt は、開始時刻の 1 ミリ秒後になる。"
  endUndecided: Boolean!
  isFree: Boolean!
  name: String!
  description: String!
  extended: [ExtendedItem!]!
  genres: [Genre!]!
  "音声の構成。主音声を先に並べる。チューナーサーバーが返さなければ空になる。"
  audios: [ProgramAudio!]!
  """
  同じイベントを共有して放送している (イベント共有) サービスのうち、元とみなすサービス。この番組が元でなければ、元のサービスを返す。
  共有していないか、この番組が元なら null。元は、同じネットワークで共有しているサービスのうち、サービス ID が最も小さいもの (地上波のメインチャンネル) にする。
  """
  sharedFrom: Service
}

"""
番組表の 1 列 (1 つのサービスの番組)。
"""
type GuideRow {
  service: Service!
  "時間帯に重なる番組を、開始時刻の順に並べたもの。"
  programs: [Program!]!
}

extend type Query {
  "ID で引く (Relay の Global Object Identification)。見つからなければ NOT_FOUND のエラーを返す。"
  node(id: ID!): Node

  "チャンネル種別を、並び順に並べたもの。"
  channelTypes: [ChannelType!]!

  """
  サービスを、番組表の並び順に並べたもの。映像か音声を流すサービスだけを返し、ワンセグやデータ放送のサービスは返さない。
  includeHidden が true なら、非表示のサービスと、ワンセグやデータ放送のサービスも返す。
  """
  services("非表示のサービスも含めるかどうか" includeHidden: Boolean! = false): [Service!]!

  """
  番組表。from から to までの時間帯に重なる番組を、サービスごとに返す。時間帯は 8 日と 1 時間まで (夏時間の切り替えの日を含む 8 日分)。
  services を省くと、非表示でない、映像か音声を流すサービスを返す (ワンセグやデータ放送のサービスは返さない)。
  指定すると、非表示のサービスや、ワンセグやデータ放送のサービスも返す。
  view を指定すると、その番組表ビューの条件で、番組を絞り込み、サービスを並べ替える。
  """
  guide(from: Time!, to: Time!, services: [ID!], view: ID): [GuideRow!]!
}
