"""
通知するイベントの種類 (設計書 6.2)。
"""
enum NotificationKind {
  "録画の開始"
  RECORDING_STARTED
  "録画の完了"
  RECORDING_COMPLETED
  "録画の失敗"
  RECORDING_FAILED
  "新たな競合の発生"
  RESERVATION_CONFLICT
  "空き容量の不足"
  STORAGE_LOW
  "チューナーサーバーへの接続不可"
  TUNER_SERVER_UNREACHABLE
}

"""
ログイン中のユーザーに届いた、画面内の通知 (設計書 6.2)。
"""
type Notification {
  id: ID!
  kind: NotificationKind!
  "出来事が起きた日時。"
  occurredAt: Time!
  "画面に出す文の材料 (番組名や理由など)。種類ごとに項目が違う。JSON の文字列。"
  payload: String!
  "画面に出す文。Web Push で送る本文と同じもの。時刻は、表示のタイムゾーンで書く。"
  message: String!
  "既読にした日時。未読なら null。"
  readAt: Time
}

type NotificationEdge {
  cursor: String!
  node: Notification!
}

type NotificationConnection {
  edges: [NotificationEdge!]!
  pageInfo: PageInfo!
}

"""
イベントの種類ごとの通知設定。
"""
type NotificationPreference {
  kind: NotificationKind!
  "画面内の通知で受け取るかどうか。"
  inApp: Boolean!
  "Web Push で受け取るかどうか。購読していなければ届かない。"
  webPush: Boolean!
  """
  ルール予約の録画の通知も受け取るかどうか。録画の通知 (開始、完了、失敗) と競合の通知でだけ使う。
  手動の予約の通知は、予約したユーザーだけに届き、ルール予約の通知は、ルールを作ったユーザーに届く (設計書 6.2)。
  """
  ruleReservations: Boolean!
}

input NotificationPreferenceInput {
  kind: NotificationKind!
  inApp: Boolean!
  webPush: Boolean!
  "省けば、今の設定のままにする。"
  ruleReservations: Boolean
}

extend type Query {
  "ログイン中のユーザーの通知を、新しい順に first 件まで返す。unreadOnly なら未読だけを返す。"
  notifications(first: Int! = 50, after: String, unreadOnly: Boolean! = false): NotificationConnection!
  "ログイン中のユーザーの未読の通知の数。"
  unreadNotificationCount: Int!
  "ログイン中のユーザーの通知設定を、すべての種類について返す。設定していない種類は、どの通知先でも受け取る。"
  notificationPreferences: [NotificationPreference!]!
}

extend type Mutation {
  "ログイン中のユーザーの通知 ids を既読にし、既読にした数を返す。ほかのユーザーの通知や、既読の通知は飛ばす。"
  markNotificationsRead(ids: [ID!]!): Int!
  "ログイン中のユーザーの未読の通知をすべて既読にし、既読にした数を返す。"
  markAllNotificationsRead: Int!
  "ログイン中のユーザーの、イベントの種類ごとの通知設定を変える。"
  updateNotificationPreference(input: NotificationPreferenceInput!): NotificationPreference!
}
