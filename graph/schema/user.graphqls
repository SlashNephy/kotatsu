"""
ユーザーのロール (設計書 9.7)。
"""
enum Role {
  "管理者"
  ADMIN
  "メンバー"
  MEMBER
  "視聴者"
  VIEWER
}

type User implements Node {
  id: ID!
  username: String!
  displayName: String!
  role: Role!
  "無効にしたユーザーかどうか。無効にしたユーザーは、ログインできない。"
  disabled: Boolean!
  createdAt: Time!
  "アイコンの画像の URL (#778)。IdP の picture を中継する。IdP が picture を返さないユーザーは null。"
  avatarUrl: String
}
