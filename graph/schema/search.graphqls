"""
過去の番組の検索の期間 (設計書 3.4)。開始時刻がこの範囲に入るアーカイブの番組も検索する。
"""
input ArchiveRangeInput {
  "期間の始まり。省くと、期間の終わりの 30 日前。"
  from: Time
  "期間の終わり。省くと、今。"
  to: Time
}

type ProgramEdge {
  cursor: String!
  node: Program!
}

type ProgramConnection {
  edges: [ProgramEdge!]!
  pageInfo: PageInfo!
}

extend type Program {
  "放送が終わり、アーカイブに移した番組かどうか。"
  archived: Boolean!
}

extend type Query {
  """
  番組の検索 (設計書 3.5)。ルールの照合と同じ照合関数で、開始時刻の順に返す。
  archive を指定したときだけ、その期間の放送が終わった番組も検索する。
  first 件そろうか、候補を照合し終えるまで探す。hasNextPage は、続きの番組が本当にあるときだけ true にする。
  サブチャンネルが元のサービスと同じ番組を流している (イベント共有) ときは、元の番組も一致していれば、元の番組だけを返す。
  照合に時間がかかりすぎたら (15 秒)、条件を絞ってもらうよう BAD_USER_INPUT を返す。
  """
  searchPrograms(
    conditions: ProgramConditionsInput!
    archive: ArchiveRangeInput
    "返す件数 (1〜100)"
    first: Int! = 50
    after: String
  ): ProgramConnection!
}
