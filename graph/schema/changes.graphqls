"""
変更を知らせるデータの種類 (設計書 1.4、9.1)。
"""
enum DataChannel {
  "番組表と番組"
  EPG
  "ルール"
  RULES
  "予約"
  RESERVATIONS
  "チューナーの割り当て"
  ASSIGNMENTS
  "予約の競合"
  RESERVATION_CONFLICTS
  "チューナーとチューナーサーバーの状態"
  TUNERS
  "録画 (#868)"
  RECORDINGS
}

"""
データの変更。何が変わったかだけを知らせるので、クライアントは、そのデータを読み直す。
"""
type DataChange {
  channel: DataChannel!
  "変更の版数。変わるたびに大きくなる。"
  version: Int!
}

"""
ヘッダーで購読する、ログイン中のユーザーへの知らせ (設計書 9.1)。1 つの知らせには、どれか 1 つだけが入る。
dataChanged、viewerSettingsChanged、unreadNotificationCount を、1 つの接続でまとめて送る。
"""
type ViewerEvent {
  dataChange: DataChange
  viewerSettingsVersion: Int
  unreadNotificationCount: Int
}

extend type Subscription {
  """
  dataChanged、viewerSettingsChanged、unreadNotificationCount を、1 つの接続でまとめて購読する (設計書 9.1)。
  HTTP/1.1 では、ブラウザが同じホストに同時に開く接続は 6 本までなので、画面が開く SSE の数を抑える。
  """
  viewerEvents: ViewerEvent!
  """
  データの変更 (設計書 9.1)。購読を始めたときに、すべての種類の今の版数を送り、その後は版数が上がった種類を送る。
  どの tenban で起きた変更も届く。
  """
  dataChanged: DataChange!
  """
  ログイン中のユーザーの未読の通知の数 (設計書 6.2、9.1)。購読を始めたときに今の数を送り、その後は数が変わったときに送る。
  通知が増えたときも、ほかの端末で既読にしたときも届く。
  """
  unreadNotificationCount: Int!
  """
  ログイン中のユーザーの設定の版数 (設計書 9.1)。購読を始めたときに今の版数を送り、その後は、同じユーザーが、どの端末からでも設定を変えたときに送る。
  クライアントは、届いたら設定を読み直す。対象の設定は、通知の設定、番組表ビュー、プレイヤーの設定、視聴予約とその通知の設定、第二要素、パスキー、セッションの失効。
  """
  viewerSettingsChanged: Int!
}
